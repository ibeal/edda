# Copy to .env (gitignored) and fill in. Never commit real values.
ADMIN_PASSWORD=
AGENT_PASSWORD=
EDDA_PORT=8432
# Host directory for pg_dump backups (absolute path, or relative to this repo). Default ./backups
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# Published port binds 127.0.0.1 by default; set 0.0.0.0 to serve other machines (only role `agent` can log in)
# EDDA_BIND=127.0.0.1
# Docker network sandboxes join to reach the database
# EDDA_AGENTS_NETWORK=edda_agents
